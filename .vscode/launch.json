{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "env": {
                "ENV": "development"
            },
            "args": [
                "apps.api.main:app",
                "--reload",
                "--port", "8888"
            ],
            "jinja": true,
            "justMyCode": false
        },
        {
            "name": "Python Debugger: API Safety Worker",
            "type": "debugpy",
            "request": "launch",
            "module": "dramatiq",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/apps/api/src",
                "ENV": "development",
                "GOOGLE_APPLICATION_CREDENTIALS": "${workspaceFolder}/service_account.json"
            },
            "args": [
                "--processes", "1",
                "--threads", "1",
                "api.safety_queue:setup_safety_queue",
                "api.thread.chat.safety.safety_checkers.google_video_safety_checker"
            ],
            "jinja": true,
            "justMyCode": false
        },
        {
            "name": "Alembic Auto-generate Debug Migration",
            "type": "debugpy",
            "request": "launch",
            "module": "alembic",
            "args": ["revision", "-m", "\"debug\"", "--autogenerate"],
            "envFile": "${workspaceFolder}/.env.local"
        },
        {
            "name": "Python Debugger: Current Test File",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-v", "-s"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "ENV": "development"
            }
        },
        {
            "name": "Python: Debug Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "purpose": ["debug-test"],
            "console": "integratedTerminal",
            "justMyCode": false
        }

    ]
}
